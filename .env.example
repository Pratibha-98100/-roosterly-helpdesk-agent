# Helpdesk API (values from the Nordavo email)
HELPDESK_BASE_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_API_KEY=
CANDIDATE_EMAIL=
CANDIDATE_NAME=

# LLM via the OpenAI SDK. Default: Google Gemini free tier (OpenAI-compatible endpoint).
# For real OpenAI: remove OPENAI_BASE_URL and set OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.5-flash-lite
# Pause between LLM calls (free tier allows ~10/min)
AI_MIN_GAP_MS=7000

# Supabase (internal tracking only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Express (optional health server)
PORT=3000

# Cost report (npm run cost): USD per 1M tokens for the configured model.
# Defaults = gemini-3.5-flash-lite standard paid tier (free tier = $0).
AI_PRICE_INPUT_PER_M=0.30
AI_PRICE_OUTPUT_PER_M=2.50
